{
  "version": "greenleaf-demo-1.1",
  "rules": [
    {"rule_id":"DEAL-001","field":"deal_type","operator":"contains_normalized","threshold":"secured term loan","severity":"HIGH","message":"Deal type must be a secured term loan."},
    {"rule_id":"DEAL-002","field":"currency","operator":"eq","threshold":"INR","severity":"HIGH","message":"Facility currency must be INR."},
    {"rule_id":"DEAL-003","field":"purpose","operator":"contains_any","threshold":["biodegradable","compostable","sustainable packaging"],"severity":"MEDIUM","message":"Purpose must relate to setting up or expanding a biodegradable business."},
    {"rule_id":"DEAL-004","field":"industry","operator":"contains_any","threshold":["packaging"],"severity":"HIGH","message":"Borrower industry must be related to packaging."},
    {"rule_id":"SEC-001","field":"collateral_type","operator":"eq_normalized","threshold":"First charge over manufacturing plant and machinery","severity":"HIGH","message":"Collateral must be a first charge over manufacturing plant and machinery."},
    {"rule_id":"FIN-001","field":"loan_amount","operator":"lt","threshold":75000000.0,"severity":"HIGH","message":"Loan amount must be less than INR 75,000,000."},
    {"rule_id":"FIN-002","field":"term_years","operator":"lt","threshold":10,"severity":"MEDIUM","message":"Loan term must be less than 10 years."},
    {"rule_id":"FIN-003","field":"term_months","operator":"lt","threshold":120,"severity":"MEDIUM","message":"Loan term must be less than 120 months."},
    {"rule_id":"FIN-004","field":"interest_rate_pct","operator":"lt","threshold":10.75,"severity":"HIGH","message":"Interest rate must be less than 10.75%."},
    {"rule_id":"FIN-005","field":"estimated_dscr","operator":"lt","threshold":1.5,"severity":"HIGH","message":"Estimated DSCR must be less than 1.50x."},
    {"rule_id":"FIN-006","field":"current_ratio","operator":"gte","threshold":1.25,"severity":"HIGH","message":"Current ratio must be at least 1.25x."},
    {"rule_id":"FIN-007","field":"revenue_growth_pct","operator":"gt","threshold":10,"severity":"MEDIUM","message":"Revenue growth must be greater than 10%."},
    {"rule_id":"SEC-002","field":"collateral_market_value","operator":"gt","threshold":50000000.0,"severity":"HIGH","message":"Collateral market value must be greater than INR 50,000,000."},
    {"rule_id":"SEC-003","field":"collateral_realisable_value","operator":"gt","threshold":300000.0,"severity":"HIGH","message":"Collateral realisable value must be greater than INR 300,000."},
    {"rule_id":"SEC-004","field":"stated_collateral_coverage","operator":"gt","threshold":0.9,"severity":"HIGH","message":"Stated collateral coverage must be greater than 0.90x."},
    {"rule_id":"FIN-008","field":"total_facility_amount","operator":"lt","threshold":75000000.0,"severity":"HIGH","message":"Total facility amount must be less than INR 75,000,000."},
    {"rule_id":"FIN-009","field":"debt_to_equity","operator":"lte","threshold":2.0,"severity":"HIGH","message":"Debt-to-equity must not exceed 2.00x."}
  ]
}
